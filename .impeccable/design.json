  "narrative": {
    "northStar": "The Card Table",
    "overview": "Felt table; a vote is a face-down card at your seat; the reveal turns them all at once. Bright card stock is the only light surface; oxblood backs, Bodoni numerals, brass only for consensus.",
    "keyCharacteristics": [
      "Felt owns the viewport",
      "Bodoni numerals, system sans UI",
      "Printed corner indices",
      "State shown as card state"
    ],
    "rules": [
      {
        "name": "The Brass Is Consensus Rule",
        "body": "Brass appears only on the Consensus mark.",
        "section": "colors"
      },
      {
        "name": "The Two Surfaces Rule",
        "body": "On-felt text on felt, ink on stock; never crossed.",
        "section": "colors"
      },
      {
        "name": "The Numerals Are Printed Rule",
        "body": "Bodoni only for values, average, wordmark.",
        "section": "typography"
      },
      {
        "name": "The Soft Shadow Rule",
        "body": "Shadows are ambient; never hard offset; buttons are the only controls with one.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show vote state as slot, back, face.",
      "Do print rotated corner indices on every face.",
      "Do set Average below the numeral in plain case.",
      "Do use on-felt for focus and selection on felt."
    ],
    "donts": [
      "Don't use status dots or leak a value before reveal.",
      "Don't use brass outside Consensus.",
      "Don't add kickers/eyebrows or hard offset shadows.",
